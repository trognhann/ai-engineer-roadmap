DATABASE_URL=postgresql://user:password@localhost:5432/mydb
SECRET_KEY=super-secret-key-12345


# App Settings
DEBUG=True
API_TIMEOUT=30

# LLM Providers
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
DEFAULT_MODEL=gpt-4o-mini
DEFAULT_TEMPERATURE=0.0

# AI Gateway (Lab 02)
GATEWAY_MAX_INPUT_TOKENS=2048
GATEWAY_PRIMARY_MODEL=gemini-2.5-flash
GATEWAY_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-flash-latest
GATEWAY_TIMEOUT_SECONDS=15.0

# Semantic Cache & Smart Tagger (Lab 03)
SEMANTIC_CACHE_THRESHOLD=0.85
SEMANTIC_CACHE_MAX_ENTRIES=1000
EMBEDDING_MODEL=models/gemini-embedding-001

# Dynamic Model Router (Lab 04)
ROUTER_LIGHTWEIGHT_MODEL=gemini-3.5-flash-lite
ROUTER_HEAVYWEIGHT_MODEL=gemini-2.5-flash
ROUTER_COMPLEXITY_THRESHOLD=0.6

# Vector Database (sử dụng cho module RAG sau này)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=

# Observability (Langfuse / OpenTelemetry)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com